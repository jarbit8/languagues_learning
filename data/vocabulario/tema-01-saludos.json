{"id":"a1-t01-010","es":"hasta pronto","texto":"see you soon","ejemplo":"See you soon!","pron":"si yu SUN","rapido":"si-ya SUN"},
{"id":"a1-t01-011","es":"hasta mañana","texto":"see you tomorrow","ejemplo":"See you tomorrow!","pron":"si yu tu-MO-rou","rapido":"si-ya tu-MO-rou"},
