{"id":"a1-t01-003","es":"buenos días","texto":"good morning","ejemplo":"Good morning, Mr. Lee!","pron":"gud MOR-ning","rapido":"g'MOR-ning — la 'good' casi desaparece","tambien":"morning! a secas","nota":"good morning hasta el mediodía."},
{"id":"a1-t01-004","es":"buenas tardes","texto":"good afternoon","ejemplo":"Good afternoon, Ana!","pron":"gud af-ter-NUN"},
