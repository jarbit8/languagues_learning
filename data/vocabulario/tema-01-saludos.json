{"id":"a1-t01-025","es":"mucho gusto","texto":"nice to meet you","literal":"agradable conocerte","ejemplo":"Nice to meet you, Paul.","pron":"nais tu MIT yu","rapido":"nais-tu-MI-chu — el to+you sale 'chu'","tambien":"nice meeting you"},
{"id":"a1-t01-026","es":"¿cómo estás?","texto":"how are you?","literal":"¿cómo eres tú?","ejemplo":"Hi! How are you?","pron":"jau AR yu","rapido":"JAU-a-ya","tambien":"how's it going? · how are ya?"},
