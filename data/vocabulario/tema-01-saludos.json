{"id":"a1-t01-014","es":"de nada","texto":"you're welcome","literal":"eres bienvenido","ejemplo":"You're welcome!","pron":"yor UEL-kem","rapido":"yer-UEL-kem, y al hablar muy rápido casi y'UEL-kem","tambien":"no problem · sure · you bet · uh-huh (a-JÁ, un gruñido, solo entre amigos)"},
{"id":"a1-t01-015","es":"perdón","texto":"sorry","ejemplo":"Sorry!","pron":"SO-ri","tambien":"my bad — muy informal, entre amigos","nota":"Para disculparte por algo."},
{"id":"a1-t01-016","es":"disculpe","texto":"excuse me","literal":"excúsame","ejemplo":"Excuse me, sir.","pron":"eks-KIUS mi","rapido":"s-KIUS-mi — se comen la e del principio","nota":"Para llamar la atención o pasar."},
{"id":"a1-t01-017","es":"no hay problema","texto":"no problem","ejemplo":"No problem!","pron":"nou PRO-blem"},
{"id":"a1-t01-018","es":"sí","texto":"yes","ejemplo":"Yes, I am fine, thank you.","pron":"YES"},
