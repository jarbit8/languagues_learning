{"id":"a1-t01-006","es":"buenas noches (al dormir)","texto":"good night","ejemplo":"Good night!","pron":"gud NAIT","tambien":"night!","nota":"Solo al ir a dormir, no para saludar."},
{"id":"a1-t01-007","es":"adiós","texto":"goodbye","ejemplo":"Goodbye, Mrs. Lee!","pron":"gud-BAI","tambien":"bye · see ya"},
