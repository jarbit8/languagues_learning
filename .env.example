# Configuración de Firebase para sincronizar el progreso entre dispositivos.
#
# Copia este archivo a `.env.local` (que está en .gitignore) y rellena los valores con los
# que da la consola de Firebase en Configuración del proyecto → Tus apps → Web.
#
# Sin estas variables la app compila y funciona igual: simplemente no aparece la opción de
# conectar la cuenta y todo el progreso se queda en el dispositivo.
#
# En GitHub Actions van como secretos del repositorio con estos mismos nombres.
#
# OJO: esto no son secretos de verdad. La configuración de Firebase para web viaja dentro
# del bundle y cualquiera puede leerla desde el navegador; está fuera del repo por higiene,
# no por seguridad. Lo que protege los datos son las reglas de firestore.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
